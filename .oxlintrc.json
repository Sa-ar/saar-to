{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "nextjs",
    "import",
    "jsx-a11y",
    "node",
    "promise"
  ],
  "jsPlugins": ["./oxlint-plugin-saar-to.mjs"],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeAware": true
  },
  "ignorePatterns": [".next/**", "out/**", "build/**", "next-env.d.ts"],
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "rules": {
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "prefer-const": "error",
    "no-console": ["error", { "allow": ["warn", "error"] }],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "next/router",
            "message": "App Router: import from next/navigation."
          },
          {
            "name": "next/document",
            "message": "App Router only — do not import next/document."
          },
          {
            "name": "next/head",
            "message": "App Router: use the Metadata API instead of next/head."
          }
        ]
      }
    ],
    "import/no-cycle": "error",
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "jsx-a11y/prefer-tag-over-role": "off",
    "typescript/ban-ts-comment": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-base-to-string": "off",
    "typescript/restrict-template-expressions": "off",
    "no-magic-numbers": [
      "error",
      {
        "ignore": [-1, 0, 1, 2],
        "ignoreArrayIndexes": true,
        "ignoreDefaultValues": true,
        "ignoreNumericLiteralTypes": true,
        "ignoreEnums": true,
        "ignoreClassFieldInitialValues": true
      }
    ]
  },
  "settings": {
    "next": {
      "rootDir": "."
    },
    "react": {
      "version": "19.2.8",
      "linkComponents": [{ "name": "Link", "linkAttribute": "href" }]
    },
    "jsx-a11y": {
      "polymorphicPropName": "render"
    }
  },
  "overrides": [
    {
      "files": ["**/*.{ts,tsx}"],
      "rules": {
        "saar-to/no-magic-token": "error"
      }
    },
    {
      "files": ["**/*.{ts,tsx}"],
      "excludeFiles": ["lib/urls.ts"],
      "rules": {
        "saar-to/no-hardcoded-apex": "error"
      }
    },
    {
      "files": ["components/ui/**"],
      "rules": {
        "jsx-a11y/label-has-associated-control": "off",
        "no-magic-numbers": "off",
        "saar-to/no-magic-token": "off"
      }
    },
    {
      "files": ["components/clicks-chart.tsx", "lib/ssrf.ts", "lib/files.ts"],
      "rules": {
        "no-magic-numbers": "off"
      }
    },
    {
      "files": ["scripts/**"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["oxlint-plugin-saar-to.mjs"],
      "rules": {
        "no-magic-numbers": "off"
      }
    }
  ]
}
